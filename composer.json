{
    "name": "ttpryg/config",
    "description": "A flexible, standalone PHP configuration management library with dot-notation support.",
    "type": "library",
    "license": "MIT",
    "keywords": ["config", "configuration", "dot-notation", "array-access"],
    "authors": [
        {
            "name": "Toto",
            "email": "totoprayogo1916@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1 || ^8.2 || ^8.3 || ^8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "rector/rector": "^2.6",
        "laravel/pint": "^1.20"
    },
    "autoload": {
        "psr-4": {
            "Ttpryg\\Config\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ttpryg\\Config\\Test\\": "tests/"
        }
    },
    "support": {
        "source": "https://github.com/ttpryg/config",
        "issues": "https://github.com/ttpryg/config/issues"
    },
    "scripts": {
        "test": "phpunit --colors=always --testdox",
        "fix:check": [
            "rector process --dry-run",
            "pint --test"
        ],
        "fix": [
            "rector process",
            "pint"
        ]
    }
}
